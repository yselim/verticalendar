{
  "name": "verti-calendar",
  "version": "0.0.1",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:clean": "npx expo prebuild --clean",
    "compile": "tsc --noEmit -p . --pretty",
    "lint": "eslint . --fix",
    "lgn": "eas login -b",
    "lint:check": "eslint .",
    "align-deps": "npx expo install --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "adb": "adb reverse tcp:8081 tcp:8081",
    "build:ios:sim": "dotenv -e .env.local -- eas build --profile development --platform ios --local",
    "build:ios:device": "dotenv -e .env.local -- eas build --profile development:device --platform ios --local",
    "build:ios:preview": "dotenv -e .env.local -- eas build --profile preview --platform ios --local",
    "build:ios:prod": "dotenv -e .env.local -- eas build --profile production --platform ios --local",
    "build:android:sim": "dotenv -e .env.local -- eas build --profile development --platform android --local",
    "build:android:device": "dotenv -e .env.local -- eas build --profile development:device --platform android --local",
    "build:android:preview": "npx dotenv -e .env.local -- eas build --profile preview --platform android --local",
    "build:android:prod": "dotenv -e .env.local -- eas build --profile production --platform android --local",
    "eas:whoami": "dotenv -e .env.local -- eas whoami",
    "android:aot": "adb shell cmd package compile -m speed -f com.verticalendar",
    "check:compiler": "node scripts/check-react-compiler.js"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.17.9",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-notifications": "~57.0.24",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "dotenv-cli": "^11.1.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
