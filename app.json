{
  "name": "VertiCalendar",
  "slug": "VertiCalendar",
  "scheme": "verticalendar",
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "light",
  "icon": "./assets/images/app-icon-all.png",
  "updates": {
    "url": "https://u.expo.dev/ce39307f-f4ba-4e88-9b66-ed4bed2fcd64",
    "fallbackToCacheTimeout": 0,
    "checkAutomatically": "ON_LOAD"
  },
  "android": {
    "icon": "./assets/images/app-icon-android-legacy.png",
    "package": "com.verticalendar",
    "adaptiveIcon": {
      "foregroundImage": "./assets/images/app-icon-android-adaptive-foreground.png",
      "backgroundImage": "./assets/images/app-icon-android-adaptive-background.png"
    },
    "allowBackup": false
  },
  "ios": {
    "icon": "./assets/images/app-icon-ios.png",
    "supportsTablet": true,
    "bundleIdentifier": "com.verticalendar",
    "privacyManifests": {
      "NSPrivacyAccessedAPITypes": [
        {
          "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
          "NSPrivacyAccessedAPITypeReasons": [
            "CA92.1"
          ]
        }
      ]
    },
    "infoPlist": {
      "ITSAppUsesNonExemptEncryption": false
    }
  },
  "plugins": [
    "@react-native-community/datetimepicker",
    "expo-sqlite",
    "expo-audio",
    "expo-sharing",
    "expo-updates",
    [
      "expo-font",
      {
        "fonts": [
          "./assets/fonts/Nunito-Regular.ttf",
          "./assets/fonts/Nunito-Medium.ttf",
          "./assets/fonts/Nunito-Bold.ttf"
        ]
      }
    ],
    [
      "expo-notifications",
      {
        "sounds": [
          "./app/assets/notifications/notif_ebcrosby_notification_1.wav",
          "./app/assets/notifications/notif_jfrecords_vmax_sourcream.wav",
          "./app/assets/notifications/notif_nevak36_bird_notification.mp3",
          "./app/assets/notifications/notif_nevak36_notification.mp3",
          "./app/assets/notifications/notif_allesyt_studio_grand_notification.wav"
        ]
      }
    ],
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/app-icon-android-adaptive-foreground.png",
        "imageWidth": 300,
        "resizeMode": "contain",
        "backgroundColor": "#191015"
      }
    ],
    [
      "expo-build-properties",
      {
        "android": {
          "enableMinifyInReleaseBuilds": true,
          "enableShrinkResourcesInReleaseBuilds": true,
          "buildArchs": [
            "arm64-v8a"
          ]
        }
      }
    ],
    "./plugins/withAndroidSystemBars"
  ],
  "experiments": {
    "tsconfigPaths": true,
    "reactCompiler": true
  },
  "extra": {
    "eas": {
      "projectId": "ce39307f-f4ba-4e88-9b66-ed4bed2fcd64"
    }
  },
  "owner": "y.selimdogan"
}
